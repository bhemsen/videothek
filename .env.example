# Absolute path to the media library (read-only). Required.
MEDIA_ROOT=/mnt/media
# Directory for the SQLite database (users, sessions, progress, library index).
DATA_DIR=./data
# HTTP bind address and port.
HOST=0.0.0.0
PORT=8080
# Periodic full rescan interval in minutes (backstop for missed watcher events).
RESCAN_INTERVAL_MIN=15
# Initial admin account, created on first start when no users exist.
ADMIN_USER=admin
ADMIN_PASSWORD=
# On-demand conversion of not-playable items. Unset disables the feature
# entirely. No spaces allowed (see README "Conversion (on-demand)").
CONVERTER_CMD=
# Directory for verified conversion copies. Defaults to <DATA_DIR>/converted;
# must not overlap MEDIA_ROOT and must not lie inside this app's public/ dir.
CONVERT_DIR=
